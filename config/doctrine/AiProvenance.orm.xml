<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusAiCatalogCopilotPlugin\Entity\AiProvenance" table="tmonier_ai_copilot_provenance">
        <unique-constraints>
            <unique-constraint name="tmonier_ai_copilot_provenance_field_uniq" columns="translation_id,field" />
        </unique-constraints>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="field" column="field" type="string" length="32" />
        <field name="generator" column="generator" type="string" length="32" />
        <field name="model" column="model" type="string" length="128" />
        <field name="generatedAt" column="generated_at" type="datetime_immutable" />
        <field name="acceptedAt" column="accepted_at" type="datetime_immutable" />
        <field name="contentHash" column="content_hash" type="string" length="64" />

        <many-to-one field="translation" target-entity="Sylius\Component\Core\Model\ProductTranslationInterface">
            <join-column name="translation_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="suggestion" target-entity="Tmonier\SyliusAiCatalogCopilotPlugin\Entity\AiSuggestionInterface">
            <join-column name="suggestion_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
